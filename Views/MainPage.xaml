<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:CollectionViewKeepLastItemInView.Views"
             x:Class="CollectionViewKeepLastItemInView.Views.MainPage">
    <Grid>
        <Grid.RowDefinitions>
            <!-- Data -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Text="Add item" Command="{Binding AddItemCommand}"/>

        <CollectionView ItemsUpdatingScrollMode="KeepLastItemInView"  Grid.Row="1" ItemsSource="{Binding ItemsSource}"/>
    </Grid>
</ContentPage>
